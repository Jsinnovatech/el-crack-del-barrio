# Base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/crack_del_barrio

# Auth
JWT_SECRET=cambia-este-valor-por-uno-seguro
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OTP (stub de desarrollo - en prod usar Twilio/WhatsApp Business API)
OTP_DEV_CODE=123456

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Storage (stub local - en prod usar S3/Cloudinary/Supabase Storage)
UPLOADS_DIR=./uploads

# Entorno
ENV=development
